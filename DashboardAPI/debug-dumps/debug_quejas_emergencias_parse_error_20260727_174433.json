            function sincronizarHaciaFlotante() {
                pares.forEach(function(p){
                    var f = document.getElementById(p[0]), r = document.getElementById(p[1]);
                    if (!f || !r) { return; }
                    if (r.type === 'checkbox') { f.checked = r.checked; } else { f.value = r.value; }
