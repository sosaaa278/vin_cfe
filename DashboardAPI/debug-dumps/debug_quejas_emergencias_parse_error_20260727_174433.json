                  ,{ yAxis: 0,  type: tipoLinea, name: 'E. Generadas',                data: valores_emergencias_generadas,         visible : visibilidad_gen,         color: color_e_pend, lineWidth: grosorLinea, dashStyle: 'Solid',     marker: { enabled: (tamMarcador > 0), symbol: 'circle',   radius: tamMarcador  }, dataLabels: { enabled: verEtiquetas, rotation: 0, color: color_e_pend, align: 'center', x: 0, y: -3, style: {fontSize: tamEtiqueta,fontWeight: 'bold', fontFamily: 'Verdana, sans-serif', strokeWidth: 1, textOutline: '#ffffff' } } }
