<script>


      function getItemsSelector (url,selector,valorVacio,textoVacio,seleccionaPrimeroUltimo){
          
          //var selectorObjetivo = $('#selectorDivision');

          selector.val(null).empty(); // val(null) remueve lo seleccionado,  .empty remueve los items
            
                $.ajax({
                    type: 'GET',
                    url: url,
                    dataType: 'json'
                }).then(function (data) {
        
              

                    /*
                        ////selector.html('').select2({data: [{id: '', text: ''}]}); 
                        select2(destroy) -> remueve el plugin select2 y deja el select normal
                      */
                    selector.val(null).empty(); // val(null) remueve lo seleccionado,  .empty remueve los items
                    
                    if ( valorVacio.length > 0 ) { 
 
                      selector.append('<option value="' + valorVacio + '"  >' + textoVacio+ '</option>');
                    }
                    
                    var indiceSelected ;
                    
                    if(data.results) {
                    indiceSelected = data.results.length;
                    ////////--console.log(indiceSelected);
                    }

                    var selected="";

      

                    $(data.results).each(function(i, v){ // indice, valor

                      ////////--console.log(i);

                            if(seleccionaPrimeroUltimo == 'primero' && i <= 0) {

                              ////////--console.log('primero');
                              selected="selected='selected'";


                            } if(seleccionaPrimeroUltimo === 'ultimo' &&  i >= (indiceSelected-1) ) {

                              ////////--console.log('ultimo');
                              selected='selected="selected"';


                            }else {

                              selected="";

                            }


                            //if(v.id == 'E03' || v.id == 'E06' || v.id == 'E07' || v.id == 'Q01' || v.id == 'Q02' || v.id == 'Q07' ) {
                            if(v.id == 'E01' || v.id == 'E02' || v.id == 'E03' || v.id == 'E04' || v.id == 'E05' || v.id == 'E06' || v.id == 'E07' || v.id == 'Q01' || v.id == 'Q02' || v.id == 'Q03' || v.id == 'Q04' || v.id == 'Q06' || v.id == 'Q07' || v.id == 'Q08' || v.id == 'QC2' || v.id == 'QC7' ) {
                              selected='selected="selected"';
                            }

        
                            selector.append('<option value="' + v.id + '" ' + selected + ' >' + v.text + '</option>');
                      })


                }); 
                
        }


