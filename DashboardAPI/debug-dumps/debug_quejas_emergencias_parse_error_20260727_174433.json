      // Convierte una fecha YYYY-MM-DD a timestamp UTC
      function fechaUtc(d) {
          const [a, m, d2] = d.split('-').map(Number);
          return Date.UTC(a, m - 1, d2);
      }

      // Genera array de plotBands para cada día entre inicio y fin
      function generarPlotBands(fechaInicioStr, fechaFinStr) {
          const plotBands = [];

          const inicio = new Date(fechaInicioStr);
          const fin = new Date(fechaFinStr);
          const unDia = 24 * 60 * 60 * 1000; // ms en un día

          for (let f = new Date(inicio); f <= fin; f = new Date(f.getTime() + unDia)) {
              const desde = Date.UTC(f.getFullYear(), f.getMonth(), f.getDate());
              const hasta = Date.UTC(f.getFullYear(), f.getMonth(), f.getDate() + 1);

              plotBands.push({
                  from: desde,
                  to: hasta,
                  color: f.getDate() % 2 === 0 ? 'rgba(0, 0, 255, 0.05)' : 'rgba(0, 255, 0, 0.05)',
                  label: {
                      text: f.toISOString().split('T')[0], // muestra la fecha
                      align: 'center',
                      verticalAlign: 'top',
                      style: { color: '#333' }
                  }
              });
          }

          return plotBands;
      }

      // Suma elemento por elemento (por hora) de dos series. Si algún operando es null/undefined
      // (serie "sin dato" por descarga fallida), el resultado de esa hora es null (hueco, no cero).
      function sumarSeriesPorHora(a, b) {
          var out = [];
          var n = Math.max(a ? a.length : 0, b ? b.length : 0);
          for (var i = 0; i < n; i++) {
              var va = a ? a[i] : null;
              var vb = b ? b[i] : null;
              if (va === null || va === undefined || vb === null || vb === undefined) {
                  out.push(null);
              } else {
                  out.push(va + vb);
              }
          }
          return out;
      }

      // ----- Overlay bloqueante de pantalla durante actualizaciones -----
      function mostrarOverlay(msg) {
          if (msg) { $("#overlayCargaMsg").html(msg); }
          $("#overlayCarga").show();
      }
      function ocultarOverlay() {
          $("#overlayCarga").hide();
      }
      // Formato dd-mm-yyyy hh:mm
      function fmtFechaHora(d) {
          var dd = ('0' + d.getDate()).slice(-2);
          var mm = ('0' + (d.getMonth() + 1)).slice(-2);
          var yyyy = d.getFullYear();
          var hh = ('0' + d.getHours()).slice(-2);
          var mi = ('0' + d.getMinutes()).slice(-2);
          return dd + '-' + mm + '-' + yyyy + ' ' + hh + ':' + mi;
      }

      // Contador de cargas de red pendientes (cubre getAtend + tabla_v3): se oculta al llegar a 0
      function overlayInc(msg) { window._cargasRed = (window._cargasRed || 0) + 1; mostrarOverlay(msg); }
      function overlayDec() {
          window._cargasRed = Math.max(0, (window._cargasRed || 0) - 1);
          if (window._cargasRed === 0) {
              ocultarOverlay();
              // Al terminar TODA la actualización de red: mostrar fecha/hora de generación y duración
              if (window._reporteInicio) {
                  var fin = new Date();
                  var ms = fin - window._reporteInicio;
                  var durTxt = (ms < 60000) ? (Math.round(ms / 1000) + ' seg') : ((ms / 60000).toFixed(1) + ' min');
                  $("#infoReporte").html('Reporte generado: <b>' + fmtFechaHora(window._reporteInicio) + '</b> &nbsp;&mdash;&nbsp; Duraci&oacute;n: <b>' + durTxt + '</b>');
                  window._reporteInicio = null;
              }
          }
      }

      // Marca/limpia el botón Actualizar cuando hay cambios que SÍ requieren consulta
      function marcarPendiente() { $("#btnActualizar").addClass("pendiente"); $("#hintPendiente").show(); }
      function limpiarPendiente() { $("#btnActualizar").removeClass("pendiente"); $("#hintPendiente").hide(); }

      // Si la exportación a PDF falla (sombras y/o etiquetas de valores, que svg2pdf no vectoriza con muchos
      // puntos), se ofrece reintentar SIN sombras NI valores mediante un modal con botón claro.
      function ofrecerPDFSimplificado(chart, optsPDF) {
          var ov = document.createElement('div');
          ov.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.45);z-index:2000000000;display:flex;align-items:center;justify-content:center;';
          var box = document.createElement('div');
          box.style.cssText = 'background:#fff;border-radius:8px;padding:18px 20px;max-width:400px;font-family:Verdana,sans-serif;font-size:13px;color:#333;text-align:center;box-shadow:0 6px 24px rgba(0,0,0,0.3);';
          box.innerHTML = '<div style="margin-bottom:14px;line-height:1.4;">No se pudo generar el PDF con todos los detalles (sombras, valores y marcadores). Esto pasa cuando hay muchos datos en la gr&aacute;fica.</div>';
          var btnOk = document.createElement('button');
          btnOk.textContent = 'Generar versión simple (solo líneas)';
          btnOk.style.cssText = 'background:#1F5B51;color:#fff;border:none;border-radius:5px;padding:8px 14px;font-size:12px;cursor:pointer;margin:0 6px;';
          var btnCancel = document.createElement('button');
          btnCancel.textContent = 'Cancelar';
          btnCancel.style.cssText = 'background:#ccc;color:#333;border:none;border-radius:5px;padding:8px 14px;font-size:12px;cursor:pointer;margin:0 6px;';
          function cerrar(){ if (ov.parentNode) { ov.parentNode.removeChild(ov); } }
          btnOk.onclick = function(){
              cerrar();
              try {
                  // shadow/dataLabels están definidos POR SERIE y eso gana sobre plotOptions.series;
                  // por eso el override debe ser un arreglo series[] de la misma longitud.
                  // Nota: chartOptions sólo afecta la COPIA temporal de exportación; la gráfica en pantalla NO cambia.
                  var ovr = [];
                  var nSeries = (chart.options && chart.options.series) ? chart.options.series.length : chart.series.length;
                  for (var i = 0; i < nSeries; i++) { ovr.push({ shadow: false, dataLabels: { enabled: false }, marker: { enabled: false } }); }
                  chart.exportChartLocal(optsPDF, { plotOptions: { series: { shadow: false, dataLabels: { enabled: false }, marker: { enabled: false } } }, series: ovr });
              } catch (e) {
                  alert('Aún así no se pudo generar el PDF. Prueba activar "Agrupar por día" o exportar en PNG.');
              }
          };
          btnCancel.onclick = cerrar;
          box.appendChild(btnOk); box.appendChild(btnCancel);
          ov.appendChild(box);
          document.body.appendChild(ov);
      }

      // Modal de aviso de PERIODO GRANDE (>31 días con datos pesados de SICOSS). Botones "Continuar"/"Cancelar".
      // 'onContinuar' se ejecuta al pulsar Continuar; Cancelar sólo cierra (el usuario ajusta filtros).
      function mostrarAvisoPeriodo(nDias, onContinuar) {
          var ov = document.createElement('div');
          ov.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.45);z-index:2000000000;display:flex;align-items:center;justify-content:center;';
          var box = document.createElement('div');
          box.style.cssText = 'background:#fff;border-radius:8px;padding:18px 22px;max-width:460px;font-family:Verdana,sans-serif;font-size:13px;color:#333;text-align:center;box-shadow:0 6px 24px rgba(0,0,0,0.3);';
          box.innerHTML = '<div style="margin-bottom:14px;line-height:1.5;">Has seleccionado un periodo de <b>' + nDias + ' d&iacute;as</b>.<br><br>'
                        + 'La gr&aacute;fica de <b>Pendientes</b> es r&aacute;pida (base de datos), pero <b>Atendidas, Generadas, '
                        + 'Totales, Monitoreo pendientes</b> y los listados/res&uacute;menes se consultan de SICOSS, y con un periodo '
                        + 'tan amplio la generaci&oacute;n puede tardar <b>varios minutos</b>.<br><br>'
                        + '&iquest;Deseas continuar con la consulta?</div>';
          var btnOk = document.createElement('button');
          btnOk.textContent = 'Continuar';
          btnOk.style.cssText = 'background:#1F5B51;color:#fff;border:none;border-radius:5px;padding:8px 18px;font-size:12px;cursor:pointer;margin:0 6px;';
          var btnCancel = document.createElement('button');
          btnCancel.textContent = 'Cancelar';
          btnCancel.style.cssText = 'background:#ccc;color:#333;border:none;border-radius:5px;padding:8px 18px;font-size:12px;cursor:pointer;margin:0 6px;';
          function cerrar(){ if (ov.parentNode) { ov.parentNode.removeChild(ov); } }
          btnOk.onclick = function(){ cerrar(); if (typeof onContinuar === 'function') { onContinuar(); } };
          btnCancel.onclick = cerrar;
          box.appendChild(btnOk); box.appendChild(btnCancel);
          ov.appendChild(box);
          document.body.appendChild(ov);
      }

      // Reglas automáticas del filtro según periodo (días) y división seleccionados.
      // - Periodo > 3 días: activar "Agrupar por día" automáticamente.
      // - Nacional (D0) o periodo > 3 días: desmarcar e inhabilitar "Listado atendidas".
      function aplicarReglasFiltros() {
          var ini = (document.getElementById("fechaSeleccionada_inicial") || {}).value || '';
          var fin = (document.getElementById("fechaSeleccionada_final") || {}).value || '';
          var dias = 0;
          if (ini && fin) { dias = (new Date(fin) - new Date(ini)) / (1000 * 60 * 60 * 24); }

          var divEl = document.getElementById("quedivision");
          var esNacional = divEl && divEl.value == '-1';

          // 1) Periodo > 3 días -> agrupar por día
          var chkDia = document.getElementById("ver_por_dia");
          if (chkDia && dias > 3) { chkDia.checked = true; }

          // 2) Listado atendidas: requiere zona(s) específica(s) seleccionada(s) y periodo <= 3 días.
          //    (Antes dependía de "no Nacional"; ahora se permite bajo Nacional si hay zonas elegidas.)
          var arregloZonasR = [].concat($('#selectZona').val() || []);
          var hayZonasR = arregloZonasR.filter(function(z){ return z && z !== '-1'; }).length > 0;
          var chkListado = document.getElementById("check_listados_atendidas");
          if (chkListado) {
              if (!hayZonasR || dias > 3) {
                  chkListado.checked = false;
                  chkListado.disabled = true;
              } else {
                  chkListado.disabled = false;
              }
          }
      }

      // Tope máximo del periodo (días), DINÁMICO según la división seleccionada:
      // Nacional (D0 = -1) -> 31 días;  una división específica -> 730 días (2 años).
      // El tope amplio es viable porque las consultas SICOSS se parten por mes (chunking) para periodos > 31 días.
      // Debe coincidir con la validación del submit.
      function diasMaxPeriodo() {
          var div = document.getElementById("quedivision");
          var v = div ? div.value : '';
          // 730 SÓLO si hay una división específica (código tipo "DW"). Placeholder 'XX' (Seleccionar...),
          // Nacional '-1' o sin selección ('') -> 31, para no burlar el límite eligiendo fechas primero.
          return (v && v !== '-1' && v !== 'XX') ? 730 : 31;
      }

      // El límite de diasMaxPeriodo() se muestra SÓLO en el campo "Desde" (relativo a "Hasta"):
      // "Hasta" queda libre (sin días deshabilitados por la regla) y acota a "Desde" al rango
      // [Hasta - diasMaxPeriodo(), Hasta]. Si "Desde" queda fuera, se reajusta.
      function limitarDesdeSegunHasta() {
          var $ini = $("#fechaSeleccionada_inicial");
          var $fin = $("#fechaSeleccionada_final");
          var d2 = $fin.datepicker("getDate");
          if (!d2) { return; }
          var min = new Date(d2); min.setDate(min.getDate() - diasMaxPeriodo());
          $ini.datepicker("option", "minDate", min);
          $ini.datepicker("option", "maxDate", d2);
          var ini = $ini.datepicker("getDate");
          if (ini && ini > d2)       { $ini.datepicker("setDate", d2); }
          else if (ini && ini < min) { $ini.datepicker("setDate", min); }
      }

      // Re-dibuja las gráficas con los datos ya cargados (sin volver a consultar a SICOSS),
      // aplicando las opciones de visualización actuales (tipo de línea, etiquetas, sombra, tamaño).
      // Muestra un destello breve del overlay para dar feedback consistente.
      function refrescarGraficas() {
          if (!window._argsGraficas) { return; }
          mostrarOverlay('Aplicando cambios...');
          setTimeout(function(){
              configurarGraficos.apply(null, window._argsGraficas);
              setTimeout(ocultarOverlay, 220);
          }, 30);
      }

      // Captura la visibilidad actual de las series de cada gráfica (por nombre de serie),
      // leyendo de las instancias guardadas antes de recrearlas.
      function capturarVisibilidadSeries() {
          var mapa = {};
          if (window._chartsById) {
              for (var id in window._chartsById) {
                  var ch = window._chartsById[id];
                  if (ch && ch.series) {
                      mapa[id] = {};
                      ch.series.forEach(function(s){ mapa[id][s.name] = s.visible; });
                  }
              }
          }
          return mapa;
      }

      // Restaura en la nueva gráfica la visibilidad que tenían las series con el mismo nombre.
      function aplicarVisibilidadSeries(chart, id, mapa) {
          if (!chart || !mapa || !mapa[id]) { return; }
          var cambio = false;
          chart.series.forEach(function(s){
              if (mapa[id].hasOwnProperty(s.name) && s.visible !== mapa[id][s.name]) {
                  s.setVisible(mapa[id][s.name], false);
                  cambio = true;
              }
          });
          if (cambio) { chart.redraw(); }
      }

      function configurarGraficos( title_periodo, labelx_rotacion, labelx_fontsize, labelx_prefijo
                ,queFecha_ini,queFecha_fin, queZona,nomZona,eje_x,valores_emergencias_pendientes,valores_quejas_pendientes,valores_emergencias_atendidas
                ,valores_emergencias_atendidas_acum,valores_emergencias_generadas
                ,valores_emergencias_generadas_acum
                ,valores_quejas_atendidas,valores_quejas_atendidas_acum
                ,valores_quejas_generadas,valores_quejas_generadas_acum
                ,valores_quejas_pendientes_detalle,valores_emergencias_pendientes_detalle,valores_emergencias_atendidas_detalle
                ,valores_quejas_atendidas_detalle,valores_emergencias_generadas_detalle,valores_quejas_generadas_detalle
                ,valores_q07_pendientes,valores_q07_atendidas,valores_q07_generadas ){

                // Guardar los argumentos para poder re-dibujar (al cambiar opciones de visualización) sin volver a consultar
                window._argsGraficas = Array.prototype.slice.call(arguments);

                // Capturar la visibilidad actual de las series (lo que el usuario prendió/apagó en la leyenda)
                // ANTES de recrear las gráficas, para restaurarla después y no perder su selección.
                var _visGuardada = capturarVisibilidadSeries();


                // ----- Conversión Q07 -> Emergencia EN VIVO (cliente) -----
                // El backend manda los valores crudos (Q07 en Quejas) + el delta de Q07 por hora.
                // Si el checkbox está activo, movemos Q07 de Quejas a Emergencias en COPIAS locales
                // (sin mutar los args guardados, para poder prender/apagar sin reconsultar).
                var conv_q07_e_on = (document.getElementById("conv_q07_e") && document.getElementById("conv_q07_e").checked);

                function aplicarQ07(valE, valQ, delta) {
                    if (!conv_q07_e_on || !delta) { return [valE, valQ]; }
                    var e = valE ? valE.slice() : valE;
                    var q = valQ ? valQ.slice() : valQ;
                    for (var i = 0; i < delta.length; i++) {
                        var d = delta[i] || 0;
                        if (d && e && q && e[i] !== null && q[i] !== null) {
                            e[i] = (e[i] || 0) + d;
                            q[i] = (q[i] || 0) - d;
                            if (q[i] < 0) { q[i] = 0; }
                        }
                    }
                    return [e, q];
                }

                var _p = aplicarQ07(valores_emergencias_pendientes, valores_quejas_pendientes, valores_q07_pendientes);
                valores_emergencias_pendientes = _p[0]; valores_quejas_pendientes = _p[1];

                var _a = aplicarQ07(valores_emergencias_atendidas, valores_quejas_atendidas, valores_q07_atendidas);
                valores_emergencias_atendidas = _a[0]; valores_quejas_atendidas = _a[1];

                var _g = aplicarQ07(valores_emergencias_generadas, valores_quejas_generadas, valores_q07_generadas);
                valores_emergencias_generadas = _g[0]; valores_quejas_generadas = _g[1];


                // ----- Granularidad por día EN VIVO (cliente) -----
                // El backend siempre envía los puntos por HORA. Si el usuario activa "Agrupar por día",
                // colapsamos los puntos horarios a diarios SOBRE COPIAS locales (sin reconsultar).
                // Reglas según la naturaleza de cada serie:
                //   - Atendidas/Generadas (flujo/conteo) -> suma de las horas del día
                //   - Pendientes (nivel/stock)           -> promedio del día
                //   - Acumuladas (acumulado corrido)     -> último valor del día
                function _agruparPorDia(ejeHoras) {
                    var dias = []; var idx = {};
                    for (var i = 0; i < ejeHoras.length; i++) {
                        var dia = (ejeHoras[i] || '').substring(0, 10);
                        if (!idx[dia]) { idx[dia] = []; dias.push(dia); }
                        idx[dia].push(i);
                    }
                    return { dias: dias, idx: idx };
                }
                function _aggSerie(arr, agr, regla) {
                    if (!arr) { return arr; }
                    var out = [];
                    for (var d = 0; d < agr.dias.length; d++) {
                        var idxs = agr.idx[agr.dias[d]];
                        var suma = 0, cnt = 0, ult = null, hayDato = false;
                        for (var k = 0; k < idxs.length; k++) {
                            var v = arr[idxs[k]];
                            if (v === null || v === undefined) { continue; }
                            hayDato = true; suma += v; cnt++; ult = v;
                        }
                        if (!hayDato) { out.push(null); }
                        else if (regla === 'sum') { out.push(suma); }
                        else if (regla === 'last') { out.push(ult); }
                        else { out.push(Math.round(suma / cnt)); } // 'avg'
                    }
                    return out;
                }
                function _aggDetalle(obj, agr, regla) {
                    if (!obj) { return obj; }
                    var out = {};
                    for (var key in obj) { if (obj.hasOwnProperty(key)) { out[key] = _aggSerie(obj[key], agr, regla); } }
                    return out;
                }

                var verPorDia = (document.getElementById("ver_por_dia") && document.getElementById("ver_por_dia").checked);
                if (verPorDia && eje_x && eje_x.length) {
                    var _agr = _agruparPorDia(eje_x);
                    valores_emergencias_pendientes = _aggSerie(valores_emergencias_pendientes, _agr, 'avg');
                    valores_quejas_pendientes      = _aggSerie(valores_quejas_pendientes,      _agr, 'avg');
                    valores_emergencias_atendidas  = _aggSerie(valores_emergencias_atendidas,  _agr, 'sum');
                    valores_quejas_atendidas       = _aggSerie(valores_quejas_atendidas,       _agr, 'sum');
                    valores_emergencias_generadas  = _aggSerie(valores_emergencias_generadas,  _agr, 'sum');
                    valores_quejas_generadas       = _aggSerie(valores_quejas_generadas,       _agr, 'sum');
                    valores_emergencias_atendidas_acum = _aggSerie(valores_emergencias_atendidas_acum, _agr, 'last');
                    valores_quejas_atendidas_acum      = _aggSerie(valores_quejas_atendidas_acum,      _agr, 'last');
                    valores_emergencias_generadas_acum = _aggSerie(valores_emergencias_generadas_acum, _agr, 'last');
                    valores_quejas_generadas_acum      = _aggSerie(valores_quejas_generadas_acum,      _agr, 'last');
                    valores_emergencias_pendientes_detalle = _aggDetalle(valores_emergencias_pendientes_detalle, _agr, 'avg');
                    valores_quejas_pendientes_detalle      = _aggDetalle(valores_quejas_pendientes_detalle,      _agr, 'avg');
                    valores_emergencias_atendidas_detalle  = _aggDetalle(valores_emergencias_atendidas_detalle,  _agr, 'sum');
                    valores_quejas_atendidas_detalle       = _aggDetalle(valores_quejas_atendidas_detalle,       _agr, 'sum');
                    valores_emergencias_generadas_detalle  = _aggDetalle(valores_emergencias_generadas_detalle,  _agr, 'sum');
                    valores_quejas_generadas_detalle       = _aggDetalle(valores_quejas_generadas_detalle,       _agr, 'sum');
                    // Etiquetas del eje X en formato dd/mm/yyyy (la clave interna sigue siendo YYYY-MM-DD)
                    eje_x = _agr.dias.map(function(d){ return d.substring(8,10) + '/' + d.substring(5,7) + '/' + d.substring(0,4); });
                }


                ///////////  GRAFICOS

 
      
                var graficas_detalle = document.getElementById("graficas_detalle").checked;
                var reporte_ejecutivo = document.getElementById("reporte_ejecutivo").checked;

                var reporte_ejecutivo = document.getElementById("reporte_ejecutivo").checked;

                // Tipo de línea para todas las series: 'spline' (suave) o 'line' (normal)
                var tipoLinea = (document.getElementById("linea_suave") && document.getElementById("linea_suave").checked) ? 'spline' : 'line';

                // Mostrar u ocultar las etiquetas de datos en los puntos
                var verEtiquetas = (document.getElementById("ver_etiquetas") && document.getElementById("ver_etiquetas").checked) ? true : false;

                // Sombra en las líneas (objeto para que sea más visible que la sombra por defecto)
                var verSombra = (document.getElementById("ver_sombra") && document.getElementById("ver_sombra").checked) ? { color: '#333333', offsetX: 1, offsetY: 3, width: 5 } : false;

                // Tamaño de la fuente de las etiquetas de datos
                var tamEtiqueta = (document.getElementById("tam_etiqueta") ? document.getElementById("tam_etiqueta").value : '9') + 'px';

                // Grosor de línea y tamaño de marcador (en vivo), por separado para series PRINCIPALES y para las de "Tipos de orden".
                // Nota: NO usar "|| default" porque 0 es falsy y "Sin marcador" (0) quedaría descartado. Usar isNaN.
                var _grLin = parseFloat(document.getElementById("grosor_linea")     ? document.getElementById("grosor_linea").value     : '3.5');
                var grosorLinea    = isNaN(_grLin) ? 3.5 : _grLin;
                var _tmMar = parseInt(  document.getElementById("tam_marcador")     ? document.getElementById("tam_marcador").value     : '4', 10);
                var tamMarcador    = isNaN(_tmMar) ? 4 : _tmMar;
                var _grLinD = parseFloat(document.getElementById("grosor_linea_det") ? document.getElementById("grosor_linea_det").value : '2');
                var grosorLineaDet = isNaN(_grLinD) ? 2 : _grLinD;
                var _tmMarD = parseInt(  document.getElementById("tam_marcador_det") ? document.getElementById("tam_marcador_det").value : '2', 10);
                var tamMarcadorDet = isNaN(_tmMarD) ? 2 : _tmMarD;



        
                var color_e_pend = reporte_ejecutivo == true          ? '#1F3864' : '#ff0000';
                var color_q_pend = reporte_ejecutivo == true          ? '#ED7D31' : '#ff0000';

