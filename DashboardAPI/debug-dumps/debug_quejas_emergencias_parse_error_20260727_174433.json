function generarPPT() {

  // PPT multi-zona (Fase 2): el .pptx es binario; se pide por AJAX como BLOB y se dispara la descarga
  // en el cliente (sin pestaña nueva). Las zonas se envían como arreglo (clave-nombre "DW12,DX13").
  var arreglotiposordenes = $('#tipoordenes_select').val() || [];
  var queDivision = document.getElementById("quedivision").value;
  var zonasPPT = [].concat($('#selectZona').val() || []).filter(function(z){ return z && z !== '-1'; });

  if (zonasPPT.length === 0) { alert('Seleccione una o más zonas para generar el PPT.'); return; }

  // El PPT consulta SICOSS por el periodo: no se permite un rango mayor a 31 días.
  var fIniPPT = document.getElementById("fechaSeleccionada_inicial").value;
  var fFinPPT = document.getElementById("fechaSeleccionada_final").value;
  var diasPPT = (new Date(fFinPPT) - new Date(fIniPPT)) / (1000 * 60 * 60 * 24);
  if (isNaN(diasPPT) || diasPPT < 0) { alert('Revise las fechas seleccionadas para el PPT.'); return; }
  if (diasPPT > 31) {
      alert('El PPT de afectaciones no permite un periodo mayor a 31 días.\nSu periodo actual es de ' + Math.round(diasPPT) + ' días. Ajuste las fechas.');
      return;
  }

  var params = new URLSearchParams();
  params.append('fecha', document.getElementById("fechaSeleccionada_inicial").value);
  params.append('fechafin', document.getElementById("fechaSeleccionada_final").value);
  params.append('selectzona', zonasPPT.join(','));                 // backend: explode(',') -> arreglo de zonas
  params.append('selectdivision', queDivision);
  params.append('arreglotiposordenes', arreglotiposordenes.join(','));
  params.append('tablas_detalle', document.getElementById("tablas_detalle").checked);
  params.append('reporte_ejecutivo', document.getElementById("reporte_ejecutivo").checked);

  if (typeof overlayInc === 'function') { overlayInc('Generando PPT de afectaciones...'); }

  var xhr = new XMLHttpRequest();
  xhr.open('POST', 'ppt_afectaciones_v2.php', true);
  xhr.responseType = 'blob';
  xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');

  xhr.onload = function () {
      if (typeof overlayDec === 'function') { overlayDec(); }
      if (xhr.status !== 200) { alert('No se pudo generar el PPT (HTTP ' + xhr.status + ').'); return; }
      var blob = xhr.response;
      var filename = 'afectaciones.pptx';
      var cd = xhr.getResponseHeader('Content-Disposition');
      if (cd) { var m = /filename="?([^";]+)"?/i.exec(cd); if (m && m[1]) { filename = m[1]; } }
      var url = window.URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      window.URL.revokeObjectURL(url);
  };
  xhr.onerror = function () {
      if (typeof overlayDec === 'function') { overlayDec(); }
      alert('Error de red al generar el PPT de afectaciones.');
  };

  xhr.send(params.toString());
}
  
