function generarReporteCOE(skipAvisos) {

        var queDivision = document.getElementById("quedivision").value;

        var queDivision_text_obj = $("#quedivision").find(':selected');
        var queDivision_text =  $(queDivision_text_obj).text();
        var queDivision_key =  $(queDivision_text_obj).val();



        var queZona = document.getElementById("selectZona").value; 

        var queZona_text_obj = $("#selectZona").find(':selected');
        
        var queZona_text =  $(queZona_text_obj[0]).text();
        var queZona_key=  $(queZona_text_obj[0]).val();

        // Zonas seleccionadas (multi). "Todas" (-1) o vacío = sin filtro de zona.
        var arregloZonas = [].concat($('#selectZona').val() || []);
        var zonasSel = arregloZonas.filter(function(z){ return z && z !== '-1'; });
        var hayZonas = zonasSel.length > 0;


        if(queDivision == '' || queDivision =='XX') {

         alert("Seleccione una división"); return 0;

        }


        var arreglotiposordenes = $('#tipoordenes_select').val(); 
                  if (arreglotiposordenes) {
                     //// alert("Ordenes: " + arreglotiposordenes.join(", "));
                     if(arreglotiposordenes == '' || arreglotiposordenes =='-1') {

                      alert("Debe seleccionar algun tipo de orden");
                      return 0;

                      }

                  } else {
                     alert("Debe seleccionar algun tipo de orden");
                     return 0;
                  }
        



        

        var objSelZona = document.getElementById("selectZona");

        var nomZona = '';

        if ( hayZonas ) {

          // Una o varias zonas seleccionadas.
          if ( zonasSel.length === 1 ) {
            nomZona += zonasSel[0] + ' - Zona '+ queZona_text.substring(7, queZona_text.length) ;
          } else {
            // Varias zonas: clave + nombre de cada una. El texto de la opción ya es "DW12 - Nombre".
            var zonasTextos = $('#selectZona').find('option:selected').filter(function(){ return $(this).val() !== '-1'; }).map(function(){ return $.trim($(this).text()); }).get();
            nomZona += zonasSel.length + ' zonas: ' + zonasTextos.join(', ') ;
          }

        } else if ( queDivision_key == '-1' ) {

          nomZona += queDivision_text.substring(5, queDivision_text.length) ;

        } else {

          nomZona += queDivision_key + ' - División ' + queDivision_text.substring(5, queDivision_text.length) ;

        }

         
        
        var queFecha_ini = document.getElementById("fechaSeleccionada_inicial").value; 
        var queFecha_fin = document.getElementById("fechaSeleccionada_final").value; 

        var tablas_detalle = document.getElementById("tablas_detalle").checked; 
        var reporte_ejecutivo = document.getElementById("reporte_ejecutivo").checked;
        var check_listados_atendidas = document.getElementById("check_listados_atendidas").checked;

        // Optimización: sólo descargar atendidas/generadas si alguna gráfica solicitada las necesita.
        // En no-ejecutivo se necesitan siempre (las gráficas E0/Q0 incluyen esas series).
        var ver_g_aten = document.getElementById("ver_g_aten").checked;
        var ver_g_gen  = document.getElementById("ver_g_gen").checked;
        var ver_g_tot  = document.getElementById("ver_g_tot").checked;

        var req_atendidas = ( !reporte_ejecutivo || ver_g_aten || ver_g_tot || check_listados_atendidas );
        var req_generadas = ( !reporte_ejecutivo || ver_g_gen  || ver_g_tot );

        // Conversiones de tipo de orden (homologadas con las tablas)
        var conv_q07_e = document.getElementById("conv_q07_e").checked;
        var conv_qc2_q = document.getElementById("conv_qc2_q").checked;
        var conv_qc7_q = document.getElementById("conv_qc7_q").checked;


        // Aviso: el gráfico de Pendientes usa el corte de la hora en punto, que tarda ~3 minutos
        // en quedar listo. Si la fecha final es HOY y aún no pasan 3 min de la hora, se avisa.
        var ver_g_pend = document.getElementById("ver_g_pend").checked;
        var necesitaPendientes = ( ver_g_pend || ver_g_tot || !reporte_ejecutivo );

        var ahora = new Date();
        var hoyStr = ahora.getFullYear() + '-' + ('0' + (ahora.getMonth() + 1)).slice(-2) + '-' + ('0' + ahora.getDate()).slice(-2);

        if ( !skipAvisos && necesitaPendientes && queFecha_fin == hoyStr && ahora.getMinutes() < 3 ) {
            var hh = ('0' + ahora.getHours()).slice(-2);
            var msg = "El gráfico de Pendientes usa el corte de la hora en punto, que tarda unos 3 minutos en quedar listo.\n\n"
                    + "Para las " + hh + ":00, genérelo a partir de las " + hh + ":03.\n\n"
                    + "¿Desea continuar de todas formas?";
            if ( !confirm(msg) ) { return 0; }
        }



        // Tope dinámico: 31 días en Nacional, 730 días (2 años) si hay una división seleccionada.
        const dias_permitidos_listado = diasMaxPeriodo();

        const fecha1 = new Date(queFecha_fin);
        const fecha2 = new Date(queFecha_ini);
        const diferenciaMs = fecha1 - fecha2;
        const diferenciaDias = diferenciaMs / (1000 * 60 * 60 * 24);




        if( check_listados_atendidas  == true   ) {


            if ( !hayZonas ) {

               alert("La opción -- Incluir listado atendidas -- solo debe seleccionarse a nivel de Zona (seleccione una o más zonas). Favor de ajustar sus opciones.");
               return 0;

            }
            


        } 


            if(diferenciaDias > dias_permitidos_listado ) {

               alert("El periodo de consulta no debe ser mayor a " +dias_permitidos_listado + " días. Su periodo actual es de "+diferenciaDias + " dias. Favor de ajustar el periodo de consulta.");
               return 0;

            }

        
            


        // Aviso de PERIODO GRANDE (>31 días): la gráfica de Pendientes es rápida (BD directa), pero Atendidas,
        // Generadas, Totales, Monitoreo y listados/resúmenes se consultan de SICOSS y pueden tardar varios minutos.
        // Sólo se avisa si se piden datos pesados; el usuario puede continuar o cancelar para ajustar filtros.
        if ( !skipAvisos && diferenciaDias > 31 ) {
            var mostrar_resumen_chk = document.getElementById("mostrar_resumen").checked;
            var hayPesado = ( req_atendidas || req_generadas || tablas_detalle || check_listados_atendidas || mostrar_resumen_chk );
            if ( hayPesado ) {
                // Modal propio: "Continuar" re-invoca la generación saltando los avisos; "Cancelar" no hace nada.
                mostrarAvisoPeriodo( Math.round(diferenciaDias), function(){ generarReporteCOE(true); } );
                return 0;
            }
        }


        $("#divReporte").html("");
        $("#divResumen").html("");

        $("#divReporte_atendidas_E0").html("");
        $("#divReporte_atendidas_Q0").html(""); 
        $("#divppt").html("");

        $("#divReporte_atendidas_E0").hide(); 
        $("#divReporte_atendidas_Q0").hide();

        $("#divppt").hide();
       
        

        var divGrafica_E0 = document.getElementById("divGrafica_E0");
        var divGrafica_Q0 = document.getElementById("divGrafica_Q0");
        var divGrafica_G0 = document.getElementById("divGrafica_G0");
        var divGrafica_TOT = document.getElementById("divGrafica_TOT");


        
        $.ajax({
          url: 'reportes_sicoss_pendientes_getAtend.php',
          type: 'post',
          data: {

             'fecha' : queFecha_ini 
            ,'fechafin' : queFecha_fin
            ,'selectzona' : ([].concat($('#selectZona').val() || [])) 
            ,'selectdivision' : queDivision
            ,'arreglotiposordenes': arreglotiposordenes
            ,'tablas_detalle': tablas_detalle
            ,'reporte_ejecutivo': reporte_ejecutivo
            ,'check_listados_atendidas': check_listados_atendidas
            ,'req_atendidas': req_atendidas
            ,'req_generadas': req_generadas
            ,'conv_q07_e': conv_q07_e
            ,'conv_qc2_q': conv_qc2_q
            ,'conv_qc7_q': conv_qc7_q

          },
          beforeSend: function(){

                overlayInc('Recopilando datos de SICOSS. Puede tardar unos minutos...');
                limpiarPendiente();
                window._reporteInicio = new Date();   // inicio de la generación del reporte
                $("#infoReporte").html('Generando reporte&hellip; Inicio: <b>' + fmtFechaHora(window._reporteInicio) + '</b>');

                $("#divGrafica_E0").html("");
                $("#divGrafica_Q0").html("");
                $("#divGrafica_G0").html("");
                $("#divGrafica_TOT").html("");
                $("#divAvisoIntegridad").html("");
                $("#divppt").html("");
                $("#divppt").show();

                if(check_listados_atendidas == true) {  

                    $("#divReporte_atendidas_E0").show(); 
                    $("#divReporte_atendidas_Q0").show();
                      
                    $("#divReporte_atendidas_E0").html(" <img height='50px' src='cargando_22.gif' /> Actualizando listado emergencias atendidas ...");   
                    $("#divReporte_atendidas_Q0").html(" <img height='50px' src='cargando_22.gif' /> Actualizando listado quejas atendidas ...");   

                }

                $("div").remove(".highcharts-data-table");

                $("#divReporte").html(""); 
                $("#divResumen").html("");
                $("#divResumen_e_edomun").html("");                           
                $("#divResumen_q_edomun").html("");  

                },
          success: function(data){

          
              if (divGrafica_E0.style.opacity !== undefined) {

                divGrafica_E0.style.opacity = 1;

              } else {

                //alert("Your browser doesn't support this example!");

              }


              if (divGrafica_Q0.style.opacity !== undefined) {

                divGrafica_Q0.style.opacity = 1;

              } else {

                //alert("Your browser doesn't support this example!");

              }
                ////////--console.log( data );


                const arregloEstadisticos = data; // JSON.parse(data);

                Object.entries(arregloEstadisticos).forEach((entry) => {

                  const [key, value] = entry;
                  ////////--console.log(`${key}: ${value}`);

                });
                        


                var eje_x = arregloEstadisticos['eje_x'];
                var valores_emergencias_pendientes = arregloEstadisticos['valores_emergencias_pendientes'];
                var valores_quejas_pendientes = arregloEstadisticos['valores_quejas_pendientes'];
                var valores_emergencias_atendidas = arregloEstadisticos['valores_emergencias_atendidas'];
                var valores_emergencias_atendidas_acum = arregloEstadisticos['valores_emergencias_atendidas_acum'];
                var valores_emergencias_generadas = arregloEstadisticos['valores_emergencias_generadas'];
                var valores_emergencias_generadas_acum = arregloEstadisticos['valores_emergencias_generadas_acum'];
                var valores_quejas_atendidas = arregloEstadisticos['valores_quejas_atendidas'];
                var valores_quejas_atendidas_acum = arregloEstadisticos['valores_quejas_atendidas_acum'];
                var valores_quejas_generadas = arregloEstadisticos['valores_quejas_generadas'];
                var valores_quejas_generadas_acum = arregloEstadisticos['valores_quejas_generadas_acum'];

                // Delta Q07 por hora (para aplicar la conversión Q07->Emergencia en vivo en el cliente)
                var valores_q07_pendientes = arregloEstadisticos['valores_q07_pendientes'];
                var valores_q07_atendidas  = arregloEstadisticos['valores_q07_atendidas'];
                var valores_q07_generadas  = arregloEstadisticos['valores_q07_generadas'];


                var valores_quejas_pendientes_detalle = arregloEstadisticos['valores_quejas_pendientes_detalle'];
                var valores_emergencias_pendientes_detalle = arregloEstadisticos['valores_emergencias_pendientes_detalle'];

                var valores_emergencias_atendidas_detalle = arregloEstadisticos['valores_emergencias_atendidas_detalle'];
                var valores_quejas_atendidas_detalle = arregloEstadisticos['valores_quejas_atendidas_detalle'];
                var valores_emergencias_generadas_detalle = arregloEstadisticos['valores_emergencias_generadas_detalle'];
                var valores_quejas_generadas_detalle = arregloEstadisticos['valores_quejas_generadas_detalle'];

                var html_LISTADO_ATENDIDAS_E0 = arregloEstadisticos['html_LISTADO_ATENDIDAS_E0'];
                var html_LISTADO_ATENDIDAS_Q0 = arregloEstadisticos['html_LISTADO_ATENDIDAS_Q0'];
                // El botón de PPT ahora es estático y siempre visible (#btnPPT, junto a Actualizar);
                // ya no se inyecta dinámicamente aquí. Se deja $("#divppt") sin uso.
                // var html_ppt = arregloEstadisticos['html_ppt'];
                // $("#divppt").html(html_ppt);


                // ----- Aviso de integridad de descargas (SICOSS) -----
                var integridad = arregloEstadisticos['integridad'];
                if (integridad && integridad.ok === false && integridad.fallos && integridad.fallos.length > 0) {

                    var aviso = '<div style="padding:10px 14px; border:1px solid #e0a800; background:#fff3cd; color:#664d03; border-radius:6px; font-size:12px; text-align:left;">';
                    aviso += '<strong>&#9888; Datos incompletos.</strong> Algunas descargas a SICOSS fallaron; se grafica s&oacute;lo la informaci&oacute;n disponible. Las series sin dato aparecen como hueco (no como cero).<ul style="margin:6px 0 0 18px; padding:0;">';

                    integridad.fallos.forEach(function(f){
                        aviso += '<li>Divisi&oacute;n <b>' + f.zona + '</b> &mdash; ' + f.tipo + ' <i>(' + f.motivo + ')</i>';
