                var visibilidad_aten = reporte_ejecutivo == true      ? false : true;
                //var visibilidad_atenacum = reporte_ejecutivo == false  ? false : false;
                var visibilidad_gen = reporte_ejecutivo == true       ? false : true;

                
                

                               


                Highcharts.setOptions({
                  lang: {
