# ===========================================================================
# Plantilla de secretos del DashboardAPI.
# Copia este archivo como ".env" y rellena los valores reales.
# El ".env" real NO se sube a git (está en .gitignore).
# Convención ASP.NET Core: "__" equivale a ":" en appsettings.json.
# ===========================================================================

# Clave de firma JWT (cadena larga y aleatoria, mín. 32 caracteres)
Jwt__Key=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Usuarios de acceso (agrega más incrementando el índice: Users__2__...)
Users__0__Username=admin
Users__0__Password=CAMBIA_ESTA_CONTRASENA
Users__1__Username=usuario.imu
Users__1__Password=CAMBIA_ESTA_CONTRASENA
